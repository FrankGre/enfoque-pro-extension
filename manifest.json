{
  "manifest_version": 3,
  "name": "Filtro Visual Anti-Relleno",
  "version": "1.0",
  "description": "Limpia las webs para mostrar solo el contenido principal.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
  "128": "icon.png"
},
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
      
    }
  ]
  
}
